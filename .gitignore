# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# Android
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
android/*.jks

# IDE
.idea/
.vscode/
*.iml

# Misc
.DS_Store
*.log

# Shared sync key, kept out of the command line so it never reaches shell history
# or a process listing. See server/gateway/KEY-ROTATION.md.
#
# This one line matters more than it looks: the rotation procedure tells the
# operator to `printf` the key into `.sync_key` and pass it as
# `SYNC_KEY="$(cat .sync_key)"`. Without this ignore rule that file would be
# picked up by a later `git add -A` and the freshly rotated key would land in a
# public repository — the exact mistake the rotation was meant to undo.
.sync_key

# Gabia deployment credentials. Same reasoning as above, larger blast radius:
# an FTP password in a public repository is a hosted-site takeover, not just a
# shared key. `scripts/auto_deploy.sh` also refuses to run if this file is
# tracked, because once a secret is in the history, deleting the file is not
# enough.
.env.gabia
.env.sync

# Deployment history: rollback snapshots (can be hundreds of MB) and the
# manifest of each release. Kept on disk for recovery, never committed — a
# snapshot of somebody's site has no business in a source repository.
.deploy/

# Gateway runtime state
server/gateway/data/

# 가비아 제출 산출물 (로컬 검증용, 커밋하지 않음)
/dist/
