# June Scheduler → 가비아 배포 설정
#
# 사용법:
#   cp scripts/env.gabia.example .env.gabia
#   chmod 600 .env.gabia
#   (아래 값을 채운 뒤)  python3 scripts/deploy_gabia.py --dry-run
#
# ⚠️ .env.gabia 는 .gitignore 에 등록되어 있습니다. 절대 커밋하지 마세요.
#    공개 저장소에 FTP 비밀번호가 들어가면 공유 키 유출이 아니라
#    "사이트 탈취"입니다. auto_deploy.sh 는 이 파일이 추적되면 실행을 거부합니다.
#
# ⚠️ 값을 채울 때 주의:
#    - 따옴표는 붙여도 되고 안 붙여도 됩니다 (양쪽 다 벗겨냅니다)
#    - 비밀번호에 # 이 들어가면 줄 앞이 아니라 = 뒤에만 써야 합니다
#      (파서가 '#'으로 시작하는 줄만 주석으로 봅니다)


# ── 전송 방식 ────────────────────────────────────────────────────────────
# ftps : 명시적 TLS (AUTH TLS + PROT P). 가비아 표준. 포트 21.
# ftp  : 평문. 비밀번호가 그대로 흐릅니다. 가급적 쓰지 마세요.
# sftp : SSH 파일 전송. 가비아에서 별도 신청이 필요합니다. 포트 22.
GABIA_PROTOCOL=ftps

# ── 서버 주소 ────────────────────────────────────────────────────────────
# 가비아 FTP 호스트. 보통 ftp.<도메인> 또는 <도메인>.
# 가비아 마이페이지 > 호스팅 관리 > FTP/SFTP 접속정보 에서 확인.
GABIA_HOST=ftp.aqdesign.co.kr

# 위에서 sftp 를 골랐다면 22, 그 외에는 21.
GABIA_PORT=21

# ── 계정 ────────────────────────────────────────────────────────────────
# 가비아 호스팅 FTP 아이디 (도메인 전체 주소가 아닌 아이디만)
GABIA_USER=

# FTP 비밀번호
GABIA_PASS=

# ── 업로드 경로 ──────────────────────────────────────────────────────────
# 가비아 호스팅의 웹 루트. 두 가지 중 하나입니다:
#   /www   — 대부분의 가비아 웹호스팅
#   /html  — 일부 상품
# 확실하지 않으면 계정 정보를 채운 뒤  python3 scripts/deploy_gabia.py --list
# 로 최상위 디렉터리 목록을 확인하세요. (로그인만 하고 아무것도 쓰지 않습니다)
# 참고: --dry-run 은 계정 정보가 없어도 됩니다. 전송 직전까지만 확인합니다.
GABIA_PATH=/www

# ── 연결 옵션 ────────────────────────────────────────────────────────────
# 1 = 수동(패시브) 모드. 방화벽 뒤에서는 거의 항상 1이 맞습니다.
# 0 = 능동(액티브) 모드. 서버가 클라이언트로 접속을 시도하므로
#     집/회사 방화벽에서 막히기 쉽습니다.
GABIA_PASSIVE=1
