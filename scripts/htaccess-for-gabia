# June Scheduler — Apache 설정 (가비아 공유호스팅)
#
# ─────────────────────────────────────────────────────────────────────────────
# 이 파일이 필요한 이유
# ─────────────────────────────────────────────────────────────────────────────
# GitHub Pages 는 파일 확장자별 MIME 을 알아서 붙여줍니다. Apache 공유호스팅은
# 서버 설정에 등록된 확장자만 압니다. .wasm 이 목록에 없으면 브라우저가
# WebAssembly.instantiateStreaming 을 거부하고 앱이 **흰 화면**으로 남습니다.
# Flutter 웹은 CanvasKit 을 wasm 으로 쓰므로 이건 선택이 아니라 필수입니다.
#
# ─────────────────────────────────────────────────────────────────────────────
# 배포 스크립트와의 관계
# ─────────────────────────────────────────────────────────────────────────────
# scripts/deploy_gabia.py 는 build/web 을 그대로 올립니다. 이 파일은
# build/web/.htaccess 로 복사되어 함께 올라갑니다. 배포 스크립트가 자동으로
# 넣으므로 손으로 올릴 필요는 없습니다.
#
# 되돌리기(rollback)를 해도 이 파일은 스냅숏에 포함되어 함께 되돌아갑니다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 기본 문자셋 ─────────────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── MIME 타입 ───────────────────────────────────────────────────────────────
# 없으면 흰 화면이 되는 것들입니다. 순서는 중요하지 않습니다.
<IfModule mod_mime.c>
  AddType application/wasm              .wasm
  AddType application/javascript        .js .mjs
  AddType application/json              .json
  AddType application/manifest+json     .webmanifest
  AddType application/octet-stream      .bin .symbols .data
  AddType font/woff2                    .woff2
  AddType font/woff                     .woff
  AddType image/png                     .png
  AddType image/svg+xml                 .svg
  AddType text/css                      .css
</IfModule>

# ── 압축 ────────────────────────────────────────────────────────────────────
# main.dart.js 는 1.1MB 이고 gzip 으로 1/3 이 됩니다. 13MB wasm 은 압축률이
# 낮지만 그래도 줄어듭니다. 모바일 회선에서 체감 차이가 큽니다.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/wasm application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 캐시 ────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # ## 왜 index.html 은 캐시하지 않는가
  # index.html 이 "지금 어떤 main.dart.js 를 쓸지" 결정하는 유일한 문서입니다.
  # 이걸 캐시하면 새로 배포해도 사용자는 옛 index 를 계속 보게 되고, 우리는
  # "배포했는데 반영이 안 된다"를 반복해서 겪습니다. (이 앱은 BUILD_ID 를
  # 화면에 표시하므로 그때 확인할 수 있습니다.)
  ExpiresByType text/html                 "access plus 0 seconds"

  # 해시가 파일명에 없는 자산. 짧게 잡습니다.
  ExpiresByType application/javascript    "access plus 10 minutes"
  ExpiresByType application/wasm          "access plus 10 minutes"
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  # index.html 은 어떤 캐시도 붙잡으면 안 됩니다.
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # ## 왜 wasm 에 CORS 헤더를 붙이는가
  # CanvasKit 의 일부 로딩 경로가 fetch 로 wasm 을 가져옵니다. 같은 출처면
  # CORS 가 필요 없지만, CDN 이나 별도 서브도메인에서 자산을 받는 구성으로
  # 바뀌면 이 헤더가 없을 때 조용히 실패합니다. 붙여서 손해가 없습니다.
  <FilesMatch "\.wasm$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # 서버 버전을 광고하지 않습니다.
  Header unset X-Powered-By
  Header unset Server

  # 클릭재킹 방지. 이 앱은 프레임에 넣을 이유가 없습니다.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── SPA 폴백 ────────────────────────────────────────────────────────────────
# 이 앱은 URL 라우팅을 쓰지 않으므로(index.html 하나) 원래 필요 없습니다.
# 다만 나중에 라우팅을 켜면 이 규칙이 404 를 막습니다.
# 실제로 존재하는 파일·디렉터리는 그대로 두고, 없는 경로만 index.html 로.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 이미 있는 파일/디렉터리는 통과
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 존재하지 않는 경로 → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ── 디렉터리 목록 금지 ──────────────────────────────────────────────────────
Options -Indexes

# ── 접근 금지 파일 ──────────────────────────────────────────────────────────
# 빌드 산출물 중 공개할 이유가 없는 것들.
<FilesMatch "^(\.last_build_id|\.nojekyll|CNAME|.*\.map)$">
  Require all denied
</FilesMatch>
