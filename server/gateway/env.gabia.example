# =============================================================================
# June Scheduler — 가비아 서버 .env (게이트웨이 설정)
# =============================================================================
# 설치 위치: /srv/june7486/sites/scheduler/.env
# 권한     : chmod 600, 소유자 june:june
#
#   sudo install -m 600 -o june -g june .env /srv/june7486/sites/scheduler/.env
#
# ⚠️ 이 파일은 .gitignore 에 등록되어 있습니다. 절대 커밋하지 마세요.
#    값을 메일·채팅으로 보내지도 마세요. 운영 DB 덤프와 같은 등급입니다.
#
# ⚠️ 이 템플릿은 **값이 비어 있습니다.** 복사한 뒤 서버에서 직접 채우세요.
#    템플릿에 실제 값을 적어 저장하면 그 순간 유출입니다.
# =============================================================================


# ── 바인딩 ──────────────────────────────────────────────────────────────────
# HOST 는 반드시 127.0.0.1 입니다.
# systemd 유닛(june-gateway.service)이 이 값을 덮어쓰므로 여기 없어도 되지만,
# 명시해두면 "왜 loopback 인지"를 파일만 보고 알 수 있습니다.
#
# 0.0.0.0 으로 바꾸지 마세요. 게이트웨이에는 인증이 공유키 하나뿐이라
# 인터넷에 열리는 순간 포트 스캔 대상이 됩니다. Nginx 가 /api/ 로
# 대신 받아 넘기는 구조이므로 게이트웨이가 직접 보일 이유가 없습니다.
HOST=127.0.0.1
PORT=8097


# ── 저장 모드 ───────────────────────────────────────────────────────────────
# local : 서버 디스크의 JSON 파일 (권장 — NAS 의존 없음)
# dsm   : Synology NAS API (NAS_HOST/USER/PASS 필요)
#
# ## local 을 권하는 이유
# dsm 은 NAS 가 꺼지거나 회선이 끊기면 앱 전체가 멈춥니다. 게다가 NAS 를
# 인터넷에 노출해야 해서 2026-11-20 사건 같은 일이 생깁니다. local 이면
# 서버 한 대만 관리하면 됩니다.
STORAGE=local

# local 모드의 데이터 디렉터리. systemd 의 ReadWritePaths 와 일치해야 합니다.
DATA_DIR=/srv/june7486/sites/scheduler/data


# ── 인증 ────────────────────────────────────────────────────────────────────
# 64자 hex (32바이트). 생성:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ## 이 키는 사실상 공개됩니다 — 그렇게 설계하고 운영하세요
# 배포 스크립트가 --dart-define=SYNC_KEY 로 심으면 값이 main.dart.js 안에
# 평문 리터럴로 박힙니다. 번들을 받는 누구나 읽을 수 있습니다.
#
# 그래서 실제 방어선은 이 키가 아니라 **게이트웨이를 loopback 에만 두는 것**과
# **계정 단위 인증**입니다. 키는 "아무나 두드리지 못하게" 하는 최소한의
# 빗장으로만 보세요.
#
# 공개 배포본에는 SYNC_KEY 를 심지 마세요. 설정 화면에서 입력할 수 있습니다.
# (deploy_pages.sh 가 심으려 하면 경고합니다)
#
# 16자 미만이면 /readyz 가 503 auth 로 거부합니다.
SYNC_SECRET=

# 키 회전 중 겹치는 구간에만 설정합니다. 새 키를 SYNC_SECRET 에 넣고,
# 옛 키를 여기 두면 두 키 모두 통과합니다. 회전이 끝나면 비우세요.
# 절차: server/gateway/KEY-ROTATION.md
SYNC_SECRET_PREVIOUS=


# ── CORS ────────────────────────────────────────────────────────────────────
# 같은 출처(/api/ 프록시)로 운영하면 **비워두세요.**
# 비어 있는 것이 안전한 기본값입니다. Nginx 를 거치면 브라우저 입장에서
# 앱과 API 가 같은 출처라 프리플라이트 자체가 발생하지 않습니다.
#
# 직접 다른 출처에서 부를 일이 있을 때만 쉼표로 구분해 적으세요.
CORS_ORIGINS=


# ── NAS 저장 모드 (STORAGE=dsm 일 때만) ─────────────────────────────────────
# local 을 쓰면 아래 네 줄은 전부 비워두세요.
#
# ⚠️ NAS_PORT(5001)를 인터넷에 열지 마세요. 2026-11-20 에 그 포트로
#    해외 IP 가 로그인을 시도했습니다. (INCIDENT-2026-11-20.md)
NAS_HOST=
NAS_PORT=5001
NAS_USER=
NAS_PASS=
NAS_FOLDER=/june-scheduler


# ── 로그 ────────────────────────────────────────────────────────────────────
# systemd 를 쓰면 journald 로 갑니다. 이 값을 쓰지 않아도 됩니다.
# LOG_LEVEL=info
