# June Scheduler — NAS gateway configuration
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# ── 저장 방식 ────────────────────────────────────────────────────────────
#   local = 이 머신(나스)의 디스크에 바로 저장      ← 나스에 직접 설치할 때. 가장 빠름
#   dsm   = DSM FileStation API를 거쳐 나스에 저장   ← 게이트웨이를 다른 곳에서 돌릴 때
# 비워두면 NAS_HOST 가 있으면 dsm, 없으면 local 로 자동 선택됩니다.
STORAGE=local

# local 일 때 저장 폴더 (없으면 자동 생성)
DATA_DIR=/volume1/92_Scheduler/scheduler-sync/data

# ── 나스 접속 (STORAGE=dsm 일 때만 필요) ─────────────────────────────────
# 나스에서 게이트웨이를 돌린다면 QuickConnect 대신 127.0.0.1 을 쓰세요.
# 외부 왕복이 한 번 사라집니다.
#NAS_HOST=127.0.0.1
#NAS_PORT=5001
#NAS_USER=scheduler
#NAS_PASS=여기에_비밀번호
#NAS_FOLDER=/92_Scheduler/sync

# 자체 서명 인증서면 1 (QuickConnect는 정식 인증서라 0 권장)
#NAS_INSECURE=0

# ── 공통 ─────────────────────────────────────────────────────────────────
# 브라우저에서 오는 요청에 붙일 공유 키 (비우면 누구나 접근 가능 — 외부 노출 시 필수)
SYNC_SECRET=

# 게이트웨이 포트
PORT=8097

# 캐시 유효시간 (ms). 짧을수록 즉시 반영, 길수록 빠름.
# 로컬 파일은 읽기가 1ms 라 캐시 없이도 충분히 빠릅니다.
CACHE_MS=4000

# 리버스 프록시 하위 경로에 붙일 때 (예: /scheduler-sync). 보통은 비웁니다.
#BASE_PATH=
