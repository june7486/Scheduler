# June Scheduler — NAS gateway configuration
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# 나스 접속 (QuickConnect ID 또는 내부 IP)
NAS_HOST=june7558.direct.quickconnect.to
NAS_PORT=5001
NAS_USER=scheduler
NAS_PASS=여기에_비밀번호

# 동기화 JSON이 저장될 나스 폴더 (절대경로 아님, 공유폴더 기준)
NAS_FOLDER=/92_Scheduler/sync

# 자체 서명 인증서면 1 (QuickConnect는 정식 인증서라 0 권장)
NAS_INSECURE=0

# 브라우저에서 오는 요청에 붙일 공유 키 (비우면 누구나 접근 가능)
SYNC_SECRET=

# 게이트웨이 포트
PORT=8097

# 캐시 유효시간 (ms). 짧을수록 즉시 반영, 길수록 빠름
CACHE_MS=4000
