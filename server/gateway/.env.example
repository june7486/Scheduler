# June Scheduler — NAS gateway configuration
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# ── 저장 방식 ────────────────────────────────────────────────────────────
#   local = 이 머신(나스)의 디스크에 바로 저장      ← 나스에 직접 설치할 때. 가장 빠름
#   dsm   = DSM FileStation API를 거쳐 나스에 저장   ← 게이트웨이를 다른 곳에서 돌릴 때
# 비워두면 NAS_HOST 가 있으면 dsm, 없으면 local 로 자동 선택됩니다.
STORAGE=local

# local 일 때 저장 폴더 (없으면 자동 생성)
# dsm 모드의 NAS_FOLDER 와 같은 곳을 가리키면, 두 모드를 오가도 같은 파일을 봅니다.
DATA_DIR=/volume1/92_Scheduler/sync

# ── 나스 접속 (STORAGE=dsm 일 때만 필요) ─────────────────────────────────
# 나스에서 게이트웨이를 돌린다면 QuickConnect 대신 127.0.0.1 을 쓰세요.
# 외부 왕복이 한 번 사라집니다.
#NAS_HOST=127.0.0.1
#NAS_PORT=5001
#NAS_USER=scheduler
#NAS_PASS=여기에_비밀번호
#NAS_FOLDER=/92_Scheduler/sync

# 자체 서명 인증서면 1 (QuickConnect는 정식 인증서라 0 권장)
#NAS_INSECURE=0

# ── 네트워크 ──────────────────────────────────────────────────────────────
# 게이트웨이가 바인딩할 인터페이스.
#   127.0.0.1  기본값. 이 머신에서만 접근 가능 — 리버스 프록시 뒤에 둘 때 정답.
#   0.0.0.0    모든 인터페이스. 방화벽을 직접 관리할 때만 쓰세요.
#   0.0.0.0 으로 열어두면, 방화벽이 없는 곳에 설치하는 순간 게이트웨이가
#    인터넷에 그대로 게시됩니다. 그래서 기본값을 0.0.0.0 이 아니라 loopback 으로 둡니다.
HOST=127.0.0.1

# 교차 출처로 게이트웨이를 부를 수 있는 사이트 목록 (쉼표 구분, 정확한 origin).
# 같은 출처에서 /api/ 를 프록시하면 비워두세요 — 비어 있으면 교차 출처 호출을
#  전혀 허용하지 않으며, 같은 출처 요청은 CORS 와 무관하게 계속 동작합니다.
#  비워두는 것이 기본값이고, 그것이 안전한 기본값입니다.
#CORS_ORIGINS=https://www.aqdesign.co.kr,https://www.june7486.com

# ── 공통 ─────────────────────────────────────────────────────────────────
# 브라우저에서 오는 요청에 붙일 공유 키 (비우면 누구나 접근 가능 — 외부 노출 시 필수)
# loopback 밖으로 바인딩했는데 이 값이 비어 있으면 /readyz 가 503 auth 로 답합니다.
SYNC_SECRET=

# 게이트웨이 포트
PORT=8097

# 캐시 유효시간 (ms). 짧을수록 즉시 반영, 길수록 빠름.
# 로컬 파일은 읽기가 1ms 라 캐시 없이도 충분히 빠릅니다.
CACHE_MS=4000

# /readyz 판정을 재사용하는 시간 (ms).
# 1초마다 도는 프로브가 매번 디스크 쓰기나 NAS 로그인을 하지 않게 합니다.
# 길게 잡으면 죽은 노드가 \"준비됨\"으로 남으므로 짧게 유지하세요.
READY_CACHE_MS=5000

# 리버스 프록시 하위 경로에 붙일 때 (예: /scheduler-sync). 보통은 비웁니다.
#BASE_PATH=
